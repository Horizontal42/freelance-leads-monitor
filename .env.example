# Telegram Bot Configuration
# Получить токен можно у @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Твой личный Telegram user_id (узнать можно у @userinfobot)
ADMIN_CHAT_ID=123456789

# LLM Provider Configuration
# antigravity (по умолчанию, бесплатно через CLI agy) или mistral
LLM_PROVIDER=antigravity
# Модель для Antigravity CLI: gemini-3.8-flash-medium, gemini-3.8-flash-low, gemini-3.8-flash-high, claude-sonnet-4-6
ANTIGRAVITY_MODEL=gemini-3.8-flash-medium
# Опционально: Mistral API Key (если LLM_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# Storage Configuration
DB_PATH=data/jobs.db

# Polling Intervals (в секундах)
KWORK_POLL_INTERVAL=180
FL_POLL_INTERVAL=180

# Hard Filter Settings
MIN_BUDGET=10000
# Минимальный скор для отправки в Telegram (Tier 1 Hot Lead)
HOT_SCORE_THRESHOLD=7
